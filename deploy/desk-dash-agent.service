[Unit]
Description=Desk Dash metric agent (optional second Linux PC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_WITH_LINUX_USERNAME
WorkingDirectory=/opt/desk-dash
ExecStart=/usr/bin/python3 -m desk_dash.server --agent
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/desk-dash/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
