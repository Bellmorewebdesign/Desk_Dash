# Copy to .env, chmod 600 .env, and set a unique long password before LAN access.
DASH_HOST=127.0.0.1
DASH_PORT=8765
DASH_PASSWORD=
DASH_CONFIG=./config.json
DASH_DATA_DIR=./data
# Set Coursen's real health-check URL to enable its configured entry.
# DASH_COURSEN_URL=https://your-actual-coursen-domain.example/
# For the central server polling another PC (different secret for each PC):
# DASH_AGENT_SECOND_TOKEN=
# On an agent machine use DASH_AGENT_TOKEN, DASH_AGENT_HOST, DASH_AGENT_PORT, DASH_AGENT_NAME.
# On Windows use DASH_LHM_URL=http://127.0.0.1:8085/data.json
